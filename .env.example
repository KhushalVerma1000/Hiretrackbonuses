# Public URL of the deployed site (canonical links, sitemap, share links)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_HIRETRACK_URL=https://www.codzentechnology.com
# Shown on the privacy page so people can ask for access, deletion or withdrawal of consent
NEXT_PUBLIC_CONTACT_EMAIL=

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS, local...)
DATABASE_URL=postgresql://user:password@localhost:5432/hiretrack
# Long random string. Used to hash IP addresses before storing them. If empty, IPs are not stored.
IP_HASH_SALT=

# Optional: also POST each lead to Zapier / Make / a CRM webhook after it is saved
LEAD_WEBHOOK_URL=
